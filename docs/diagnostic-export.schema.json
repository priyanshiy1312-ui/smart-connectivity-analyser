{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Network Diagnostic Export",
  "description": "Portable export of one completed network diagnostic. Unavailable measurements are represented by null. Precise location and secrets are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp",
    "test_status",
    "metrics",
    "measurement_metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "test_status": {
      "enum": [
        "completed",
        "partial"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "download_mbps",
        "upload_mbps",
        "ping_ms",
        "jitter_ms",
        "packet_loss_percent",
        "connectivity_score"
      ],
      "properties": {
        "download_mbps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "upload_mbps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ping_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "jitter_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "packet_loss_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "connectivity_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "measurement_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_type",
        "units"
      ],
      "properties": {
        "network_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "download_mbps",
            "upload_mbps",
            "ping_ms",
            "jitter_ms",
            "packet_loss_percent",
            "connectivity_score"
          ],
          "properties": {
            "download_mbps": {
              "const": "Mbps"
            },
            "upload_mbps": {
              "const": "Mbps"
            },
            "ping_ms": {
              "const": "ms"
            },
            "jitter_ms": {
              "const": "ms"
            },
            "packet_loss_percent": {
              "const": "%"
            },
            "connectivity_score": {
              "const": "%"
            }
          }
        }
      }
    }
  }
}
